<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 定义一个名为 grey 的材质 -->
    <material name="grey">
        <!-- 颜色格式为 RGBA：红、绿、蓝、透明度，取值 0~1 -->
        <!-- 这里表示灰色，不透明 -->
        <color rgba="0.5 0.5 0.5 1" />
    </material>
    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name="dark_green">
        <color rgba="0 0.4 0 1" />
    </material>

    <material name="light_green">
        <color rgba="0 0.6 0 1" />
    </material>
    

</robot>