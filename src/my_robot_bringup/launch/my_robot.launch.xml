<launch>
    <let name="urdf_path"
            value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>
    <let name="rviz_config_path"
        value="$(find-pkg-share my_robot_bringup)/config/my_robot_moveit.rviz"/>
    

    <let name="urdf_path"
            value="$(find-pkg-share my_26robot_description)/urdf/my_robot.urdf.xacro"/>
    <let name="rviz_config_path"
        value="$(find-pkg-share my_robot_bringup)/config/my_robot_moveit.rviz"/>

    <!-- 1. 启动机器人状态发布器 -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
        <param name="robot_description"
                value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <!-- 2. 启动 ros2_control_node (必须传入 robot_description 和 yaml 配置) -->
    <node pkg="controller_manager" exec="ros2_control_node" output="screen">
        <param from="$(find-pkg-share my_robot_bringup)/config/ros2_controllers.yaml" />
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <!-- 3. 启动控制器 Spawner -->
    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
    <node pkg="controller_manager" exec="spawner" args="arm_controller" />
    <node pkg="controller_manager" exec="spawner" args="gripper_controller" />


    <!-- 4. 启动 MoveIt move_group -->
    <include file="$(find-pkg-share my_robot_moveit_config)/launch/move_group.launch.py" />
    
    <!-- 5. 启动 RViz 并加载你的配置文件 -->
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" 
          args="-d $(var rviz_config_path)" />
</launch>